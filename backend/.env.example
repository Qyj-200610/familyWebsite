DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/family_website
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS — 允许的前端域名（逗号分隔）
CORS_ORIGINS=http://localhost:5175,https://family-website-frontend-six.vercel.app

# QQ SMTP 邮件配置（美食专栏点单通知）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_qq@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_NOTIFICATION_EMAIL=recipient@example.com

# 文件上传（可选，以下为默认值）
# UPLOAD_DIR=uploads          # 上传文件存储目录（相对于 backend/）
# AVATAR_MAX_SIZE=2097152     # 头像最大 2 MB（字节数）
