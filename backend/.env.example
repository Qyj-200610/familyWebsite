# ── 数据库 ──────────────────────────────────────────
# 本地 MySQL（开发）
# DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/family_website
# DATABASE_SSL=false

# TiDB Cloud Developer Tier（生产 — 需要 SSL，端口 4000）
DATABASE_URL=mysql+aiomysql://user:password@gateway01.xxx.prod.aws.tidbcloud.com:4000/database_name
DATABASE_SSL=true

# ── JWT ────────────────────────────────────────────
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS — 允许的前端域名（JSON 数组格式，也支持逗号分隔字符串）
CORS_ORIGINS=http://localhost:5175,https://your-frontend.vercel.app,https://your-site.edgeone.cool,https://your-site.pages.dev

# QQ SMTP 邮件配置（美食专栏点单通知）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_qq@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_NOTIFICATION_EMAIL=recipient@example.com

# 文件上传（可选，以下为默认值）
# UPLOAD_DIR=uploads          # 上传文件存储目录（相对于 backend/）
# AVATAR_MAX_SIZE=5242880     # 头像最大 5 MB（字节数）

# ── Cloudinary 图片存储 ────────────────────────────
# 照片和头像上传到 Cloudinary（持久化存储，替代 Render 临时磁盘）
# 注册地址：https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
